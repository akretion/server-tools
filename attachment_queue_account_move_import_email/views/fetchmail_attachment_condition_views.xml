<?xml version="1.0" ?>
<odoo>

    <record model="ir.ui.view" id="view_fetchmail_condition_journal_form">
        <field name="model">fetchmail.attachment.condition</field>
        <field
            name="inherit_id"
            ref="attachment_queue_email.view_fetchmail_attachment_condition_form"
        />
        <field name="arch" type="xml">
            <field name="file_type" position="after">
                <field
                    name="journal_id"
                    attrs="{'required': [('file_type', '=', 'account_move_import')], 'invisible': [('file_type', '!=', 'account_move_import')]}"
                />
            </field>
        </field>
    </record>

</odoo>
