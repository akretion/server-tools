<?xml version="1.0" encoding="utf-8" ?>
<odoo>

        <record id="account_move_statement_attachment_view_form" model="ir.ui.view">
            <field name="model">attachment.queue</field>
            <field
            name="inherit_id"
            ref="attachment_queue.view_attachment_queue_form"
        />
            <field name="arch" type="xml">
                <data>
                    <field name="file_type" position="after">
                        <field name="company_id" invisible="1" />
                        <field
                        name="journal_id"
                        attrs="{'invisible':[('file_type', '!=', 'account_move_import')],
                                       'required':[('file_type', '=', 'account_move_import')]}"
                    />
                    </field>
                </data>
            </field>
        </record>

</odoo>
